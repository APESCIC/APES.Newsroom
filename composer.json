{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "apescic/apes-newsroom",
    "type": "project",
    "description": "APES Newsroom: public newsroom and authenticated publishing/campaign/moderation workspaces for APES CIC, APES Shelter & Rescue, and APES Pet Care Clinic.",
    "keywords": ["laravel", "inertia", "newsroom", "apes"],
    "license": "AGPL-3.0-only",
    "require": {
        "php": "^8.4",
        "bacon/bacon-qr-code": "^3.1",
        "directorytree/ldaprecord-laravel": "^4.0",
        "firebase/php-jwt": "^7.2",
        "giggsey/libphonenumber-for-php-lite": "^9.0",
        "inertiajs/inertia-laravel": "^2.0",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0",
        "league/oauth2-client": "^2.9",
        "matomo/device-detector": "^6.5",
        "maxmind-db/reader": "^1.12",
        "pragmarx/google2fa": "^9.1",
        "predis/predis": "^3.0",
        "spatie/laravel-passkeys": "^1.8",
        "stripe/stripe-php": "^22.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Scripts\\MilestoneVersion\\": "scripts/MilestoneVersion/",
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "Composer\\Config::disableProcessTimeout",
            "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/herd-setup.ps1"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "demo:seed": [
            "@php artisan newsroom:demo-data"
        ],
        "demo:reset": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan newsroom:demo-data --reset"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "lint": [
            "@php vendor/bin/pint --test"
        ],
        "format": [
            "@php vendor/bin/pint"
        ],
        "milestone:next": "@php scripts/milestone-version next",
        "milestone:bump": "@php scripts/milestone-version bump",
        "milestone:branch": "@php scripts/milestone-version branch",
        "milestone:pr-title": "@php scripts/milestone-version pr-title",
        "milestone:check-title": "@php scripts/milestone-version check-title",
        "milestone:check-branch": "@php scripts/milestone-version check-branch",
        "milestone:check-release": "@php scripts/milestone-version check-release",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
